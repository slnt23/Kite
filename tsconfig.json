{
  "extends": "@vue/tsconfig/tsconfig.dom.json",
  "include": ["src/config/env.d.ts", "src/config/*","src/**/*"],
  "exclude": ["src/**/__tests__/*"],
  "compilerOptions": {
    "composite": true,
    "skipLibCheck": true,
    "noImplicitAny": false,
    "paths": {
      "@/*": ["./src/*"]
    },
    "types": ["vite/client"]
  }
}
